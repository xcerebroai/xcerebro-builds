# ============================================================
# Xcerebro Builds — Workspace .gitignore
# ============================================================
# This file applies to the entire workspace. Individual projects
# may have additional .gitignore files for project-specific rules.
# ============================================================

# ---- SECRETS — NEVER COMMIT ----
.env
.env.*
!.env.example
*.key
*.pem
*credentials*
*secret*
*api_key*
*api-key*
*api.key*

# ---- RAW SCRAPED DATA ----
# Per the framework spec, raw scraped data is too large for Git.
# Final processed outputs (leads.json, etc.) get committed.
*.jsonl
data/raw/
data/scraped/
data/cache/
data/_rotation_state_backup.json

# ---- LARGE DATA FILES ----
# GitHub has a 50MB hard cap. Anything close to that should not be in Git.
*.csv
*.xlsx
*.xls
*.parquet
*.zip
*.tar.gz

# Exception: small reference CSVs under /reference/ ARE committed
!reference/**/*.csv

# ---- PYTHON ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- NODE ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
.yarn/

# ---- BUILD ARTIFACTS ----
dist/
build/
out/
.next/
.nuxt/
.output/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- IDE / EDITOR ----
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/

# ---- LOGS ----
*.log
logs/
*.log.*

# ---- DATABASE ----
*.db
*.sqlite
*.sqlite3

# ---- TEMPORARY ----
*.tmp
*.temp
*.bak
*.backup
*~

# ---- AGENT WORKSPACE ----
# OpenClaw session data and agent scratch. Not for source control.
.openclaw-cache/
.agent-scratch/
session-*.json

# ---- PROJECT-SPECIFIC EXCEPTIONS ----
# Specific projects can override these in their own .gitignore
